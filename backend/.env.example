PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/juristrail

JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# AES-256 key for database encryption. Must be a 32-character string or equivalent strength.
DB_ENCRYPTION_KEY=your-super-secret-database-encryption-key-change-this


# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Self-hosted: http://localhost:8888
# Cloud: https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=http://localhost:8888


LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ---------- Frontend URL ----------
FRONTEND_URL=http://localhost:5173
